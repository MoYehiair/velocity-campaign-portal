{
  "name": "velocity-campaign-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint app lib scripts tests components/portal components/login-form.tsx",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "import:data": "node --env-file=.env --import tsx scripts/import-data.ts",
    "provision": "node --env-file=.env --import tsx scripts/provision-accounts.ts",
    "worker": "node --env-file=.env --import tsx scripts/worker.ts",
    "schema:build": "cat supabase/migrations/*.sql > schema.sql",
    "check": "npm run typecheck && npm test && npm run build",
    "verify:seed": "node --import tsx scripts/verify-seed.ts",
    "schema:format": "node --import tsx scripts/format-sql.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "csv-parse": "^7.0.2",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "iconv-lite": "^0.7.3",
    "input-otp": "1.4.2",
    "libphonenumber-js": "^1.13.13",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@cloudflare/workers-types": "5.20260911.1",
    "@electric-sql/pglite": "^0.5.8",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "sql-formatter": "^15.8.2",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "wrangler": "4.131.1"
  },
  "type": "module"
}
